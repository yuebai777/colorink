      "items": [
        {"id": "1.1", "kind": "guided", "text": "F11 全屏放大镜出现、跟着鼠标；取一次色落到前景槽",
         "action": {"steps": [{"keys": ["F11"], "wait": 1.2}], "judge": "picker_fullscreen", "screenshot": true, "restore": [{"keys": ["Esc"], "wait": 0.8}], "always_confirm": true, "prompt": "放大镜出现了吗？取色正常吗？"}},
        {"id": "1.2", "kind": "manual", "text": "切色空间模块 HSV → HLS → LCH 各一次"},
        {"id": "1.3", "kind": "manual", "text": "拖任一滑块，数值实时变"},
        {"id": "1.4", "kind": "manual", "text": "前景 / 背景交换"},
        {"id": "1.5", "kind": "manual", "text": "改一项设置 → 完全退出 → 重开，设置还在"},
        {"id": "1.6", "kind": "guided", "text": "Ctrl+Shift+T 标题栏显隐",
         "action": {"steps": [{"keys": ["Ctrl", "Shift", "T"], "wait": 0.8}], "judge": "titlebar_toggle", "restore": [{"keys": ["Ctrl", "Shift", "T"], "wait": 0.5}]}},
        {"id": "1.7", "kind": "guided", "text": "Ctrl+H 窗口显隐",
         "action": {"steps": [{"keys": ["Ctrl", "H"], "wait": 0.8}], "judge": "window_visible", "expect_visible": false, "restore": [{"keys": ["Ctrl", "H"], "wait": 0.5}]}},
