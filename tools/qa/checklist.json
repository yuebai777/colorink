        {"id": "1.9", "kind": "manual", "text": "拖到第二块屏布局不错位（单屏跳过）"},
        {"id": "1.10", "kind": "manual", "text": "UI 缩放 125% / 150% 不错位"},
        {"id": "1.11", "kind": "manual", "text": "设置 6 页逐页点开不崩"},
        {"id": "1.12", "kind": "manual", "text": "语言切 English 扫一遍无中文残留 → 切回中文"},
        {"id": "1.13", "kind": "manual", "text": "复制诊断信息内容完整"}
