# Bytecode / Python caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (local-only, never commit)
venv/
.venv/
env/

# Test & tooling artifacts
.pytest_cache/
# Throwaway .tmp_* probe dirs left at repo root by debug/agent sessions
.tmp_*/
tools/_tmp_*.py
_test_log.txt
err.txt
out.txt
test-reports/
# Regenerated at repo root by tools/probe_preview_handoff.py — one-off diagnostic dumps stay local
preview_handoff_report.txt
# Verification screenshots regenerated by tools/visual_lab_disc_check.py
screenshots/lab_disc_verify/

# Build / distribution (PyInstaller + native toolchain)
build/
build_debug*/
dist/
build_log.txt
# Specs are tracked on purpose (they are the packaging contract).
# The pattern keeps stray auto-generated specs out, the negation keeps
# Colorink*.spec addable so a renamed spec is never silently ignored.
*.spec
!Colorink*.spec
*.manifest
*.obj
# MSVC linker exports from the native picker hook (keep .c source + .dll runtime in tree)
core/picker_hook.exp
core/picker_hook.lib
# Safety copy made before swapping a running instance's picker_hook.dll
core/picker_hook.dll.bak

# Node & VitePress docs build artifacts
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
# Transient config copy VitePress writes while bundling the site config
docs/.vitepress/*.timestamp-*.mjs

# IDE / editors
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

# Stray Windows temp file accidentally committed once (entry kept for historical cleanup)
mag_filter_mode.txt

# Snipaste screenshot captures dropped next to the repo
Snipaste_*.png

# AI agent session / local tooling state (machine-specific paths — never push)
.omo/
.omc/
.reasonix/
.opencode/
.codegraph/
.workbuddy/
.workbuddy-ai/
pyrightconfig.json

# Local-only QA wizard & planning docs (kept on disk, intentionally out of repo -- see 5b45cef)
tools/qa/
tools/test_wizard.py
测试.bat
docs/superpowers/

# Throwaway debug scratch (machine-specific paths, one-off probes)
scratch/
_debug_run.bat
_rs_before.bat
_rs_after.bat
_slotback.py
_state_*.json
_v7_panel.js
qrcode_*.jpg
*.log
